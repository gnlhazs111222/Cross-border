generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  displayName     String
  catalogRevision Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  products        Product[]
  assets          ProductAsset[]
  importBatches   ImportBatch[]
  occurrences     ImportOccurrence[]
  importRules     ImportResolutionRule[]
  tasks           LaunchTask[]
  factCards       FactCard[]
  listings        ListingDraft[]
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Product {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       String
  name      String
  category  String
  position  Int      @default(0)
  revision  Int      @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  selections TaskSelection[]
  factCards FactCard[]
  listings  ListingDraft[]
  assets    ProductAsset[]
  @@unique([userId, sku])
  @@unique([userId, id])
}
model ProductAsset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String
  kind        String
  role        String
  fileName    String
  mimeType    String
  byteSize    Int
  sha256      String
  storageKey  String
  parseStatus String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([productId, sha256])
  @@index([userId, sku])
}
model ImportBatch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  mode            String
  status          String   @default("completed")
  rowCount        Int      @default(0)
  createdProducts Int      @default(0)
  counts          Json
  report          Json?
  sourceKey       String?
  sourceHash      String?
  sourceBytes     Int?
  sourceMime      String?
  urlResults      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  occurrences     ImportOccurrence[]
  @@index([userId, createdAt])
}
model ImportOccurrence {
  id                String      @id @default(cuid())
  batchId           String
  batch             ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowNumber         Int
  sku               String      @default("")
  name              String      @default("")
  verdict           String
  matchedProductId  String?
  matchedSku        String?
  conflicts         Json?
  payload           Json
  resolution        String      @default("pending")
  resolvedProductId String?
  resolvedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  @@index([userId, resolution])
  @@index([batchId])
}
model ImportResolutionRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdict      String
  field        String
  action       String
  appliedCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, verdict, field])
}
model LaunchTask {
  recommendationSnapshot Json?
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String
  platform      String
  market        String
  category      String
  requirements  Json
  minimumProfit Float
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  selections    TaskSelection[]
  factCards     FactCard[]
  listings      ListingDraft[]
  @@unique([userId, code])
  @@unique([userId, id])
}
model TaskSelection {
  id        String     @id @default(cuid())
  taskId    String     @unique
  task      LaunchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  purpose   String
  revision  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
model FactCard {
  productRevision Int @default(1)
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      LaunchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   Int
  revision  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  facts     Fact[]
  evidence  Evidence[]
  @@unique([taskId, productId, version])
}
model Fact {
  id             String   @id @default(cuid())
  factCardId     String
  factCard       FactCard @relation(fields: [factCardId], references: [id], onDelete: Cascade)
  key            String
  value          String
  source         String
  anchor         String
  status         String
  listingAllowed Boolean
  metadata       Json?
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([factCardId, key])
}
model Evidence {
  id         String   @id @default(cuid())
  factCardId String
  factCard   FactCard @relation(fields: [factCardId], references: [id], onDelete: Cascade)
  kind       String
  source     String
  data       Json
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model ListingDraft {
  status       String @default("stale")
  generationMode String @default("template")
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String
  task         LaunchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform     String
  revision     Int
  factRevision Int
  data         Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      ReviewResult[]
  publications PublishResult[]
  @@unique([taskId, productId, platform, revision])
}
model ReviewResult {
  metadata       Json?
  reviewMode     String @default("rules")
  highRiskCount  Int @default(0)
  invalidatedAt  DateTime?
  id             String       @id @default(cuid())
  listingDraftId String
  listingDraft   ListingDraft @relation(fields: [listingDraftId], references: [id], onDelete: Cascade)
  revision       Int
  status         String
  issues         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
model PublishResult {
  externalDemoId String @default("")
  invalidatedAt DateTime?
  id             String       @id @default(cuid())
  listingDraftId String
  listingDraft   ListingDraft @relation(fields: [listingDraftId], references: [id], onDelete: Cascade)
  revision       Int
  platform       String
  status         String
  data           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
model AiCall {
  promptVersion    String?
  inputHash        String?
  id               String   @id @default(cuid())
  provider         String
  model            String
  purpose          String
  latencyMs        Int
  success          Boolean
  errorCode        String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
